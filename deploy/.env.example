# Variables for the gym-logs-parser nudge stack (deploy/compose.yaml).
# Paste the ones you need into the stack's env in nudge. Do NOT point the stack's
# `env_path` at this file: nudge would overwrite your real values with these examples.
# Every value below is an example, not a real secret.
# Values are interpolated by compose: write a literal `$` as `$$`.
# Any other appsettings.json key can be overridden the same way (Section__Key).

# --- Images -------------------------------------------------------------------
# Optional. The API image. CI sets it on every deploy through the nudge deployment, by
# digest: registrydedic.zefirlabs.net/gymlogsparser@sha256:... (deploy/README.md, CI).
# Set it by hand only to pin a build, e.g. registrydedic.zefirlabs.net/gymlogsparser:main-0123456789ab
# Default: registrydedic.zefirlabs.net/gymlogsparser:latest
# API_IMAGE=registrydedic.zefirlabs.net/gymlogsparser:latest

# --- Published port -----------------------------------------------------------
# Optional. Host address the API port binds to. Default: 127.0.0.1 (only the host's
# reverse proxy reaches it). Use 0.0.0.0 if the proxy runs on another machine.
API_BIND=127.0.0.1
# Optional. Host port the reverse proxy for the API's public hostname
# (e.g. https://gymlogs-api.zefirlabs.net) forwards to. Default: 8085
API_PORT=8085

# --- Database -----------------------------------------------------------------
# Required. Npgsql connection string of the external Postgres. The database must
# exist and be owned by this user (the API creates the schema on startup).
# Values are interpolated by compose: a literal `$` in the password must be written `$$`.
ConnectionStrings__GymLogs=Host=db.example.lan;Port=5432;Database=gymlogs;Username=gymlogs;Password=example-db-password
# Optional. Apply EF Core migrations when the API starts. Default: true
Database__MigrateOnStartup=true

# --- Login (OIDC through authestra) -------------------------------------------
# Required. Issuer URL; must equal authestra's ISSUER exactly.
Auth__Authority=https://auth.example.zefirlabs.net
# Required. Client ID registered in authestra.
Auth__ClientId=gymlogs
# Required. SECRET. Client secret from authestra.
Auth__ClientSecret=example-client-secret
# Required. Cloudflare Pages URL of the frontend (no trailing slash); login and
# logout redirect back here.
Auth__FrontendUrl=https://gymlogs.zefirlabs.net

# --- Frontend / CORS ----------------------------------------------------------
# Required. Comma-separated CORS origins: the Cloudflare Pages URL (exact origin, no
# trailing slash). The frontend calls the API cross-origin with credentials.
Frontend__Cors=https://gymlogs.zefirlabs.net
# Optional. Not read by the API today; keep it equal to Auth__FrontendUrl.
Frontend__Url=https://gymlogs.zefirlabs.net

# --- DeepSeek (workout parsing) -----------------------------------------------
# Required. SECRET. DeepSeek API key.
DeepSeek__ApiKey=sk-example
# Optional. Defaults come from appsettings.json in the image.
# DeepSeek__BaseUrl=https://api.deepseek.com/
# DeepSeek__Model=deepseek-v4-flash
# DeepSeek__MaxTokens=3000
# DeepSeek__CacheMinutes=60
