# Variables for the gym-logs-parser nudge stack (deploy/compose.yaml).
# Paste the ones you need into the stack's env in nudge. Do NOT point the stack's
# `env_path` at this file: nudge would overwrite your real values with these examples.
# Every value below is an example, not a real secret.
# Values are interpolated by compose: write a literal `$` as `$$`.
# Any other appsettings.json key can be overridden the same way (Section__Key).

# --- Images -------------------------------------------------------------------
# Optional. Tag of registrydedic.zefirlabs.net/gymlogsparser (the API). Default: latest
API_TAG=latest
# Optional. Tag of registrydedic.zefirlabs.net/gymlogsparser-ui (nginx + SPA). Default: latest
UI_TAG=latest

# --- Published port -----------------------------------------------------------
# Optional. Host address the UI port binds to. Default: 127.0.0.1 (only the host's
# reverse proxy reaches it). Use 0.0.0.0 if the proxy runs on another machine.
UI_BIND=127.0.0.1
# Optional. Host port the reverse proxy for https://gymlogs.zefirlabs.net forwards to. Default: 8085
UI_PORT=8085

# --- Database -----------------------------------------------------------------
# Required. Password of the bundled postgres (set once: postgres keeps the one it
# was first created with). Avoid `;` in it: it goes into the connection string.
POSTGRES_PASSWORD=example-db-password
# Optional. Database and user of the bundled postgres. Default: gymlogs
POSTGRES_DB=gymlogs
POSTGRES_USER=gymlogs
# Optional. Npgsql connection string. Default: the bundled postgres, built from the
# three variables above. Set it to use an external database instead.
# ConnectionStrings__GymLogs=Host=db.example.lan;Port=5432;Database=gymlogs;Username=gymlogs;Password=example
# Optional. Apply EF Core migrations when the API starts. Default: true
Database__MigrateOnStartup=true

# --- Login (OIDC through authestra) -------------------------------------------
# Required. Issuer URL; must equal authestra's ISSUER exactly.
Auth__Authority=https://auth.example.zefirlabs.net
# Required. Client ID registered in authestra.
Auth__ClientId=gymlogs
# Required. SECRET. Client secret from authestra.
Auth__ClientSecret=example-client-secret
# Required. Public URL of the app; login and logout redirect back here.
Auth__FrontendUrl=https://gymlogs.zefirlabs.net

# --- Frontend / CORS ----------------------------------------------------------
# Optional. Comma-separated CORS origins. Not needed behind the bundled nginx (one
# origin); set it to the public URL so the image's dev origins don't apply.
Frontend__Cors=https://gymlogs.zefirlabs.net
# Optional. Public URL of the frontend (kept in sync with Auth__FrontendUrl).
Frontend__Url=https://gymlogs.zefirlabs.net

# --- DeepSeek (workout parsing) -----------------------------------------------
# Required. SECRET. DeepSeek API key.
DeepSeek__ApiKey=sk-example
# Optional. Defaults come from appsettings.json in the image.
# DeepSeek__BaseUrl=https://api.deepseek.com/
# DeepSeek__Model=deepseek-chat
# DeepSeek__MaxTokens=4000
# DeepSeek__CacheMinutes=60
